# ------------------------------------------------------------------------
# Demo RIS editor — environment
# Copy this file to `.env.local` and adjust the values.
# Everything ALSO lives in the `settings` SQLite table (editable in the
# /settings page of the UI); env values are only used to seed the database
# on first start.
# ------------------------------------------------------------------------

# Shared authorization key expected in the `X-Kiosk-Auth-Key` header of every
# contract call — this IS the ApiBorne `brandAuthorizationKey`, already defined
# in the ApiBorne admin (Connectivity page). LEAVE EMPTY (default) to capture
# it automatically from the first contract call (trust-on-first-use); set it
# only to pin the key explicitly.
#SEED_KIOSK_AUTH_KEY=

# Kiosk device ids known by this editor (comma separated). Kiosks are managed
# in the ApiBorne admin, so by default an unknown `X-Kiosk-Device-Id` with a
# valid key is AUTO-REGISTERED on first contact. Set
# SEED_ENFORCE_KNOWN_DEVICES=true for the strict contract behaviour
# (unknown device -> 401 UNKNOWN_DEVICE, like EasyDoct).
SEED_KNOWN_DEVICE_IDS=DEMO-KIOSK-1,DEMO-KIOSK-2
SEED_ENFORCE_KNOWN_DEVICES=false

# Identity of this "office" as known by the ApiBorne server
# (integrationEasyDocts.officeId / officeVisibleId on the ApiBorne side).
SEED_OFFICE_ID=1
SEED_OFFICE_VISIBLE_ID=demo-office-visible-id

# KioskReactor brand id (kioskReactorSettings.brandId on the ApiBorne side).
SEED_BRAND_ID=demo-brand

# ApiBorne licence UUID (shown in the ApiBorne admin, Connectivity page).
# Recommended: identifies the target licence UNAMBIGUOUSLY in the outbound
# notifications — several licences can share the same brand id. Leave empty
# to fall back to the office identity / brand id resolution.
#SEED_LICENCE_UUID=

# Base URL of the ApiBorne NestJS server, used for the two OUTBOUND
# best-effort notifications this editor emits:
#   POST /api/kioskTicket/issueForAppointment    (arrival marked in the agenda)
#   POST /api/kioskTicket/appointmentStatusChanged (every status change)
SEED_APIBORNE_SERVER_BASE_URL=http://localhost:3007

# Enable/disable the outbound notifications above (also togglable in /settings).
SEED_PUSH_ENABLED=true
