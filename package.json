{
  "name": "apiborne-demo-ris",
  "version": "1.0.0",
  "private": true,
  "description": "Reference implementation of the ApiBorne Kiosk Integration Contract — a demo RIS (Radiology Information System) editor with an agenda UI, built with Next.js, shadcn/ui, Tailwind and SQLite.",
  "scripts": {
    "dev": "next dev --turbopack -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "db:reset": "node -e \"const fs=require('fs');const p='./data/demo.db';if(fs.existsSync(p)){fs.rmSync(p)};console.log('demo.db removed — it will be recreated and seeded on next start')\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.64.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.41",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
